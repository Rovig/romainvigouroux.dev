# /etc/romainvigouroux/secrets.env — JAMAIS dans le dépôt git. Droits : root:blog 0640.

# --- Rapport hebdomadaire par e-mail (exemple Gmail : créer un "mot de passe d'application")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REPORT_TO=
REPORT_FROM=

# --- LinkedIn (app créée sur https://www.linkedin.com/developers/apps, produits
#     "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect")
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Version de l'API au format AAAAMM. LinkedIn retire les versions après ~1 an : la mettre à jour.
LINKEDIN_VERSION=202610
# Mettre à 1 pour activer la publication réelle (sinon : simulation dans le journal).
LINKEDIN_ENABLED=0
