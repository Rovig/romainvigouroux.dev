{{- $pages := where site.RegularPages "Section" "articles" -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:dc="http://purl.org/dc/elements/1.1/">
<channel>
  <title>{{ site.Title }}</title>
  <link>{{ site.Home.Permalink }}</link>
  <description>{{ site.Params.description }}</description>
  <language>{{ site.Language.Locale }}</language>
  {{- with $pages }}<lastBuildDate>{{ (index . 0).Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
  {{- with .OutputFormats.Get "rss" }}
  {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
  {{- end }}
  {{- range first 30 $pages }}
  <item>
    <title>{{ .Title }}</title>
    <link>{{ .Permalink }}</link>
    <guid isPermaLink="true">{{ .Permalink }}</guid>
    <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
    <dc:creator>{{ site.Params.author }}</dc:creator>
    <description>{{ .Description }}</description>
    {{- range .Params.tags }}<category>{{ . }}</category>{{ end }}
    <content:encoded>{{ printf "<![CDATA[%s]]>" (replace .Content "]]>" "]]]]><![CDATA[>") | safeHTML }}</content:encoded>
  </item>
  {{- end }}
</channel>
</rss>
